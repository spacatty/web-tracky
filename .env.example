# Host ports published by Docker Compose. `task dev` listens on these same ports.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432

# Browser origin for the panel and public status links.
APP_PUBLIC_URL=http://localhost:3000

# Default URL baked into enroll commands. The panel can override it per token.
AGENT_PUBLIC_URL=http://localhost:8080

# Host-side API process. Compose overrides this for the web container.
API_INTERNAL_URL=http://localhost:8080

# open: anyone can register. closed: an admin creates accounts.
AUTH_REGISTRATION=closed
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

SESSION_SECRET=dev-session-secret-change-me

POSTGRES_USER=tracky
POSTGRES_PASSWORD=tracky
POSTGRES_DB=tracky

# Used by the API when you run `task dev` on the host. Keep the port in sync with POSTGRES_PORT.
DATABASE_URL=postgres://tracky:tracky@localhost:5432/tracky?sslmode=disable

MIN_CHECK_INTERVAL_SEC=30
METRICS_RETENTION_DAYS=30

# {ip} is replaced with the agent address. Empty disables lookup.
GEO_LOOKUP_URL=https://ipwho.is/{ip}

# Bump this before `task publish-agent` so enrolled agents download a new core.
AGENT_VERSION=0.1.0

HTTP_ADDR=:8080
PACK_PATH=packs/v1.json
RELEASE_DIR=dist/agent
