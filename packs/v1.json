{
  "version": 2,
  "core_min": "0.2.0",
  "heartbeat_sec": 15,
  "job_timeout_sec": 60,
  "heartbeat": [
    {"op": "host.info", "save": "host"},
    {"op": "net.speed", "save": "speed", "interval_sec": 300, "down_bytes": 8000000, "up_bytes": 4000000, "timeout_ms": 6000}
  ],
  "check": [
    {
      "op": "http.request",
      "method": "GET",
      "url": "{{url}}",
      "timeout_ms": 10000,
      "follow_redirects": true,
      "save": "http"
    },
    {
      "op": "icmp.ping",
      "host": "{{host}}",
      "count": 3,
      "timeout_ms": 5000,
      "save": "ping"
    }
  ]
}
